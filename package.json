{
  "name": "playbook",
  "private": true,
  "description": "Playbook pipeline — structured AI-assisted development",
  "author": "Bogs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bogsp/playbook.git"
  },
  "scripts": {
    "lint": "biome check packages",
    "lint:fix": "biome check --write packages",
    "format": "biome format --write packages",
    "build": "node packages/create-playbook/build.js && node packages/playbook-skill/build.js",
    "check:drift": "node packages/check-drift.mjs",
    "test": "node --test packages/create-playbook/test/e2e.test.js",
    "budget": "node -e 'const { checkBudgets } = require(\"./packages/core-lib/budget-checker\"); const res = checkBudgets([\"packages/create-playbook/templates\", \"packages/playbook-skill/assets\"]); if (res.failed) process.exit(1); console.log(\"Budget check passed.\");'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "nx": "^21.0.0"
  },
  "version": "0.0.2"
}
