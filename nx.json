{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/biome.json"]
  },
  "targetDefaults": {
    "lint": {
      "cache": true,
      "inputs": ["default", "sharedGlobals"]
    },
    "format": {
      "cache": true,
      "inputs": ["default"]
    }
  },
  "plugins": []
}
